{
  "name": "soldev-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "generate:feature": "plop feature",
    "generate:route": "plop route",
    "generate:adr": "plop adr",
    "generate:hook": "plop hook",
    "generate:component": "plop component",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "docker:build": "docker build -t soldev-ui .",
    "docker:run": "docker run -p 8080:80 soldev-ui",
    "docker:run:detached": "docker run -d -p 8080:80 --name soldev-ui soldev-ui",
    "docker:stop": "docker stop soldev-ui",
    "docker:clean": "docker rm -f soldev-ui 2>/dev/null; docker rmi soldev-ui 2>/dev/null || true",
    "docker:rebuild": "yarn docker:clean && yarn docker:build && yarn docker:run:detached"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@vis.gl/react-google-maps": "^1.10.1",
    "apexcharts": "^7.4.0",
    "framer-motion": "^13.1.1",
    "react": "^19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query-devtools": "^5.102.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "plop": "^4.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
