import { http, HttpResponse } from 'msw'
import type { {{pascalCase name}} } from '../types'
import { env } from '@/shared/config'

const items: {{pascalCase name}}[] = []

const BASE_URL = `${env.API_ADDRESS}/{{name}}`

export const {{camelCase name}}Handlers = [
  http.post(`${BASE_URL}/getAll`, () => {
    return HttpResponse.json(items)
  }),
{{#if (includes mutations "create")}}

  http.post(`${BASE_URL}/create`, async ({ request }) => {
    const body = (await request.json()) as Partial<{{pascalCase name}}>
    const item = { ...body, id: crypto.randomUUID() } as {{pascalCase name}}
    items.push(item)
    return HttpResponse.json(item, { status: 201 })
  }),
{{/if}}
{{#if (includes mutations "update")}}

  http.post(`${BASE_URL}/update`, async ({ request }) => {
    const { id, ...changes } = (await request.json()) as Partial<{{pascalCase name}}> & { id: string }
    const item = items.find((i) => i.id === id)
    if (!item) return new HttpResponse(null, { status: 404 })
    Object.assign(item, changes)
    return HttpResponse.json(item)
  }),
{{/if}}
{{#if (includes mutations "delete")}}

  http.post(`${BASE_URL}/delete`, async ({ request }) => {
    const { id } = (await request.json()) as { id: string }
    const index = items.findIndex((i) => i.id === id)
    if (index !== -1) items.splice(index, 1)
    return new HttpResponse(null, { status: 204 })
  }),
{{/if}}
  // plop:handler
]