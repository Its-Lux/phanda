import { use{{pascalCase name}} } from '../hooks/use{{pascalCase name}}'
import { {{pascalCase name}}List } from '../components/{{pascalCase name}}List'

export function {{pascalCase name}}Page() {
  const { data, isLoading, isError } = use{{pascalCase name}}()

  if (isLoading) return <p>Loading...</p>
  if (isError) return <p>Something went wrong loading {{name}}.</p>

  return (
    <div className="max-w-md mx-auto p-4">
      <h1 className="text-xl font-bold mb-4">{{pascalCase name}}</h1>
      <{{pascalCase name}}List items={data ?? []} />
    </div>
  )
}